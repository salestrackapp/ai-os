NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon
SUPABASE_SERVICE_ROLE_KEY=chave-service-role   # servidor apenas (test:rls, páginas públicas, adapter) — nunca no client

# App
NEXT_PUBLIC_SITE_URL=https://ai-os.salestrack.com.br   # base para montar links públicos de proposta

# Segurança
MFA_ENFORCE=false                              # true = obriga MFA para admins em /admin

# WhatsApp (Z-API · Onda 1) — opcional; sem estas envs o fluxo segue em modo degradado
WHATSAPP_PROVIDER=zapi                          # zapi (default) | meta_cloud (Fase 6)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
WHATSAPP_WEBHOOK_KEY=troque-por-um-segredo      # valida ?key= no webhook
ADMIN_WHATSAPP_NUMBERS=5511999999999            # números admin (vírgula), isentos de opt-in

# Dados da CONTRATADA (usados na minuta de contrato)
SALESTRACK_CNPJ=00.000.000/0001-00
SALESTRACK_ENDERECO=São Paulo/SP

# Docusign (Fase 3) — conta real do André conectada; falta só Integration Key + RSA (criar em admin.docusign.com → Apps & Keys)
DOCUSIGN_BASE_URL=https://na4.docusign.net/restapi     # conta de PRODUÇÃO do André (na4)
DOCUSIGN_ACCOUNT_ID=ff774f79-86fd-43ed-8917-54b0650c2780
DOCUSIGN_USER_ID=5ae0aa49-e268-439b-925a-7eebd935b22c
DOCUSIGN_INTEGRATION_KEY=                        # criar em Apps & Keys + consentimento JWT
DOCUSIGN_PRIVATE_KEY=                            # chave RSA privada em base64 (uma linha)
DOCUSIGN_CONNECT_SECRET=                         # segredo HMAC do Docusign Connect (webhook)

# Pagamentos — provider ativo: asaas | stripe | manual (default: asaas se configurado, senão stripe, senão manual)
PAYMENT_PROVIDER=asaas

# ASAAS (recomendado p/ Brasil: boleto+Pix nativos) — sem chave, billing cai no manual
ASAAS_API_KEY=
ASAAS_ENV=sandbox                                # sandbox | production
ASAAS_WEBHOOK_TOKEN=troque-por-um-segredo        # header asaas-access-token do webhook

# Stripe (alternativa internacional) — opcional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mail — Resend = transacional (notificações 1:1); MailerLite = audiência/campanhas
RESEND_API_KEY=
EMAIL_FROM=AI OS · Salestrack <aios@salestrack.com.br>   # domínio precisa estar verificado no Resend
ADMIN_EMAILS=andre.kachan@salestrack.com.br      # notificações internas (vírgula)
MAILERLITE_API_KEY=                              # Integrations → API no MailerLite
MAILERLITE_GROUP_ID=191945673127495219           # grupo "AI OS · CRM Salestrack" (criado via Claude)
