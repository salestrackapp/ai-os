NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon
SUPABASE_SERVICE_ROLE_KEY=chave-service-role   # servidor apenas (test:rls, páginas públicas, adapter) — nunca no client

# App
NEXT_PUBLIC_SITE_URL=https://ai-os.salestrack.com.br   # base para montar links públicos de proposta

# Segurança
MFA_ENFORCE=false                              # true = obriga MFA para admins em /admin

# WhatsApp (Z-API · Onda 1) — opcional; sem estas envs o fluxo segue em modo degradado
WHATSAPP_PROVIDER=zapi                          # zapi (default) | meta_cloud (Fase 6)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
WHATSAPP_WEBHOOK_KEY=troque-por-um-segredo      # valida ?key= no webhook
ADMIN_WHATSAPP_NUMBERS=5511999999999            # números admin (vírgula), isentos de opt-in

# Dados da CONTRATADA (usados na minuta de contrato)
SALESTRACK_CNPJ=00.000.000/0001-00
SALESTRACK_ENDERECO=São Paulo/SP

# Docusign (Fase 3) — conta real do André conectada; falta só Integration Key + RSA (criar em admin.docusign.com → Apps & Keys)
DOCUSIGN_BASE_URL=https://na4.docusign.net/restapi     # conta de PRODUÇÃO do André (na4)
DOCUSIGN_ACCOUNT_ID=ff774f79-86fd-43ed-8917-54b0650c2780
DOCUSIGN_USER_ID=5ae0aa49-e268-439b-925a-7eebd935b22c
DOCUSIGN_INTEGRATION_KEY=                        # criar em Apps & Keys + consentimento JWT
DOCUSIGN_PRIVATE_KEY=                            # chave RSA privada em base64 (uma linha)
DOCUSIGN_CONNECT_SECRET=                         # segredo HMAC do Docusign Connect (webhook)

# Pagamentos — provider ativo: asaas | stripe | manual (default: asaas se configurado, senão stripe, senão manual)
PAYMENT_PROVIDER=asaas

# ASAAS (recomendado p/ Brasil: boleto+Pix nativos) — sem chave, billing cai no manual
ASAAS_API_KEY=
ASAAS_ENV=sandbox                                # sandbox | production
ASAAS_WEBHOOK_TOKEN=troque-por-um-segredo        # header asaas-access-token do webhook

# Stripe (alternativa internacional) — opcional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monetização (Fase 6) — cobrança da mensalidade "Plataforma AI OS". Sem estes, faturamento em modo MANUAL.
STRIPE_PRICE_BASE=                               # price ids dos planos (opcional; preenche no admin/Monetização)
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
NEXT_PUBLIC_APP_HOST=ai-os-sable.vercel.app       # host base do AI OS (links de assinatura / white-label N3)

# E-mail — Resend = transacional (notificações 1:1); MailerLite = audiência/campanhas
RESEND_API_KEY=
EMAIL_FROM=AI OS · Salestrack <aios@salestrack.com.br>   # domínio precisa estar verificado no Resend
ADMIN_EMAILS=andre.kachan@salestrack.com.br      # notificações internas (vírgula)
MAILERLITE_API_KEY=                              # Integrations → API no MailerLite
MAILERLITE_GROUP_ID=191945673127495219           # grupo "AI OS · CRM Salestrack" (criado via Claude)

# Agentes internos (Fase 5) — rodam na API Anthropic DA SALESTRACK, só no servidor (a chave nunca vai ao cliente).
# Sem ANTHROPIC_API_KEY, o Consultor responde "temporariamente indisponível" e o build passa (modo degradado).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5                   # configurável; default = Sonnet mais recente
# Consultor via Slack (opcional). Sem estes, o canal Slack fica inativo. Mapeamento canal→org: app_settings key 'slack_channels'.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Espinha comercial (Fase 5.5) — TODAS são contas da SALESTRACK (pré-venda). Nenhuma conecta a sistema de cliente.
# Todas opcionais: sem elas, o recurso cai para modo manual e o build passa.
APOLLO_API_KEY=                                   # importação/enriquecimento de prospects; ausente → CSV/colar/manual
GOOGLE_OAUTH_CLIENT_ID=                           # conta Salestrack: Gmail (enviar+ler) + Calendar (timeline)
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=                       # ausente → cadência gera rascunho/tarefa; timeline sem Gmail/Calendar
GOOGLE_SENDER_EMAIL=                              # remetente do Gmail (default: "me")
READAI_API_KEY=                                   # notas de reunião na timeline (ausente → sem ingestão Read AI)
MAILERLITE_NURTURE_GROUP_ID=                      # grupo de nurture "IA em Toda a Empresa" (default: grupo do CRM)
AGENDA_URL=                                       # link de agenda usado como CTA único nos toques frios
CRON_SECRET=                                      # protege /api/cron/cadence (Vercel Cron manda Authorization: Bearer)

# Observabilidade / FinOps (Fase 7) — todos opcionais.
USD_BRL=                                          # cotação p/ exibir custo/margem em BRL (Anthropic cobra USD). Sem isto → mostra USD.
SLACK_OPS_CHANNEL=                                # canal Slack p/ alertas críticos (usa SLACK_BOT_TOKEN da Fase 5). Sem isto → alertas só no admin.
# CRON_SECRET (Fase 5.5) também liga o cron /api/cron/ops (rollup custo + saúde + alertas, diário 06h UTC).

# Sessões ao Vivo (Fase 4b) — ferramentas de ENTREGA da Salestrack (não do cliente).
# Sem token, os webhooks respondem em modo degradado (ok:false, degraded:true) e a operação é manual no Estúdio/Programa.
CALENDLY_WEBHOOK_TOKEN=                           # /api/calendly/webhook?token=...  (invitee.created → cria sessão agendada)
READAI_WEBHOOK_TOKEN=                             # /api/readai/webhook?token=...     (pós-sessão → resumo/gravação + debita crédito)
